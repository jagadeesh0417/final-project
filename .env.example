# Everything runs with zero config out of the box (data is served from lib/data.ts).
# Fill these in only when you want to move to a real database + email.

# Optional — enable MongoDB persistence
MONGODB_URI=

# Optional — enable transactional email on enquiry submit
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=

# Public site URL, used for metadata + OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
